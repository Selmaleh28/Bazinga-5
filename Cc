:root {
    --primary: #2563eb;
    --secondary: #1e40af;
    --accent: #f59e0b;
    --bg: #f8fafc;
    --text: #1e293b;
}

body {
    font-family: 'Assistant', sans-serif;
    background-color: var(--bg);
    color: var(--text);
    margin: 0;
    display: flex;
    justify-content: center;
    min-height: 100vh;
}

.container {
    width: 100%;
    max-width: 600px;
    padding: 20px;
    text-align: center;
}

header {
    margin-bottom: 40px;
    padding-top: 20px;
}

.logo {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--primary);
}

.logo span {
    color: var(--accent);
}

.card {
    background: white;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
}

h1 {
    font-size: 1.8rem;
    margin-bottom: 10px;
}

p {
    color: #64748b;
    line-height: 1.6;
}

.status-box {
    margin: 30px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: bold;
}

.pulse {
    width: 12px;
    height: 12px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 rgba(34, 197, 94, 0.4);
    animation: pulse-animation 2s infinite;
}

@keyframes pulse-animation {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
}

button {
    background: var(--primary);
    color: white;
    border: none;
    padding: 15px 30px;
    border-radius: 50px;
    font-size: 1.1rem;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
    width: 100%;
}

button:hover {
    background: var(--secondary);
    transform: translateY(-2px);
}

#feedback {
    margin-top: 20px;
    padding: 10px;
    border-radius: 8px;
    background: #ecfdf5;
    color: #065f46;
}

.hidden { display: none; }

footer {
    margin-top: 50px;
    font-size: 0.9rem;
    color: #94a3b8;
}
